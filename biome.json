{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**/*.ts", "**/*.tsx", "!hooks/frames.ts", "!.claude-plugin/types"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
	"linter": { "rules": { "preset": "recommended", "suspicious": { "noThenProperty": "off" } } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
